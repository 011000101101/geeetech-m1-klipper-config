# Geeetech M1 Klipper configuration
#
# EXPERIMENTAL: tested on one stock Geeetech M1, but not an official Klipper
# configuration. Review every setting and keep a verified SWD backup before
# replacing the stock firmware.
#
# Current state:
# - Motion, heaters, fans, physical endstops, runout sensing, load-cell
#   probing, and the included print macros have been tested in use.
# - Stock Marlin confirmed X/Y TMC communication, but no retained evidence
#   confirms the UART interface under Klipper; its sections are disabled below.
# - The serial and virtual-SD paths below are placeholders and must be edited.
# - Probe Z offset, PID, pressure advance, and input shaping remain
#   machine-specific and must be calibrated safely.
# - The stock LCD is not supported.
#
# Important:
# - The stock display appears to be a custom parallel TFT on the STM32 FSMC bus.
# - Embedded font assets in the stock firmware further support that this is a
#   graphical TFT UI stack, not a simple HD44780/ST7920-style display.
# - Firmware literals in the `0x60000000` / `0x64000000` / `0x68000000` range
#   further support an FSMC memory-mapped 8080-style TFT path.
# - Upstream Klipper display support, per the current official config reference,
#   is for hd44780 / hd44780_spi / aip31068_spi / st7920 / emulated_st7920 /
#   uc1701 / ssd1306 / sh1106, not a generic FSMC TFT.
# - Therefore this file does NOT claim working stock-LCD support yet, and there
#   is no simple "pick ILI9341 vs ILI9488" test path in upstream Klipper for
#   this stock display wiring.

[include macros/m1_startup_macros.cfg]
# Do not also include a macro pack that defines PAUSE, RESUME, or CANCEL_PRINT
# unless you resolve the duplicate macro names first.

[mcu]
serial: /dev/serial/by-id/<your-ch340-device-id>
baud: 250000
restart_method: command

[printer]
kinematics: cartesian
max_velocity: 300
max_accel: 3000
max_z_velocity: 25
max_z_accel: 500
# TODO(VERIFY): square_corner_velocity is not directly equivalent to Marlin jerk.
# Marlin reported X/Y jerk 10 and Z jerk 3.

# Motion values below are based on recovered stock settings and live testing.

[force_move]
enable_force_move: True

[stepper_x]
step_pin: PB3
dir_pin: PB12
enable_pin: !PB0
endstop_pin: ^!PB4
position_endstop: 115
position_max: 115  # 107 bed
microsteps: 16
rotation_distance: 40
homing_speed: 30
second_homing_speed: 5
# Optional TMC2209 UART settings are documented in the disabled block below.

[stepper_y]
step_pin: PA1
dir_pin: !PA0
enable_pin: !PC7
endstop_pin: ^!PC14
position_endstop: 0
position_max: 113 # printable area starts at 5, below is wiper
microsteps: 16
rotation_distance: 40
homing_speed: 30
second_homing_speed: 5
# Optional TMC2209 UART settings are documented in the disabled block below.

[stepper_z]
step_pin: PA11
dir_pin: PC15
enable_pin: !PC13
endstop_pin: ^!PD6
position_endstop: -0.2
position_min: -0.7
position_max: 95
# Assumes 16 microsteps to match stock 830 steps/mm.
microsteps: 16
rotation_distance: 3.855422

[safe_z_home]
home_xy_position: 114, 5   # Recovered safe load-cell homing point
speed: 50.0
z_hop: 3.0
z_hop_speed: 15.0

[extruder]
step_pin: PC5
dir_pin: PE4
enable_pin: !PB7
heater_pin: PB9
sensor_pin: PC1
sensor_type: EPCOS 100K B57560G104F
min_temp: 0
max_temp: 275
max_extrude_cross_section: 3
microsteps: 16
rotation_distance: 5.614035
nozzle_diameter: 0.400
filament_diameter: 1.750
min_extrude_temp: 170
pressure_advance: 0.10
control: pid
pid_kp: 18.80
pid_ki: 1.39
pid_kd: 64.34

[heater_bed]
heater_pin: PE0
sensor_pin: PC0
sensor_type: EPCOS 100K B57560G104F
min_temp: 0
max_temp: 120
control: watermark

[fan]
# Live-confirmed part-cooling fan output.
pin: PE1

[heater_fan hotend_fan]
# Live-tested after recovery by thermal-threshold correlation.
pin: PD3
heater: extruder
heater_temp: 50.0

[heater_fan controller_fan]
# Live-tested after recovery by bed-heater correlation.
pin: PB8
heater: heater_bed

[filament_switch_sensor runout]
# Live-tested stock filament runout input.
switch_pin: ^!PD12
pause_on_runout: True

[output_pin caselight]
pin: PB15
value: 1
shutdown_value: 0


[bed_mesh]
probe_count: 4,4
mesh_min: 10,10
mesh_max: 100,100
fade_start: 1.0
fade_end: 10.0
horizontal_move_z: 2

[probe]
# daughterboard_level: processed daughterboard probe/level logic input
# from the loadcell auxiliary board.
pin: PA8
x_offset: 0
y_offset: 0
speed: 2
samples: 3
sample_retract_dist: 1.25
samples_tolerance: 0.03
samples_result: average
samples_tolerance_retries: 4
# Placeholder only: run Klipper's PROBE_CALIBRATE procedure before printing.
z_offset: 0.0
deactivate_on_each_sample: True
activate_gcode:
    LOADCELL_ZERO
deactivate_gcode:
    SET_PIN PIN=_loadcell_zero VALUE=0

[output_pin _loadcell_zero]
# daughterboard_zero: recovered daughterboard baseline-reset / tare strobe.
# Live Klipper behavior and stock-firmware RE both match a short active-high pulse.
pin: PB5
pwm: False
value: 0
shutdown_value: 0

# Optional TMC2209 UART configuration. Stock Marlin M122 confirmed both drivers,
# and firmware recovery indicates a shared USART2-backed bus on PA2/PA3, with X
# address 0 and Y address 3. No retained evidence confirms this interface under
# Klipper. It is not needed for homing because the printer uses the physical
# endstop pins configured above. Leave these sections disabled unless UART
# operation and the current settings are validated on the printer.
#
# [tmc2209 stepper_x]
# uart_pin: PA3
# tx_pin: PA2
# uart_address: 0
# run_current: 0.80
# stealthchop_threshold: 999999
#
# [tmc2209 stepper_y]
# uart_pin: PA3
# tx_pin: PA2
# uart_address: 3
# run_current: 0.80
# stealthchop_threshold: 999999

[input_shaper]
shaper_freq_x: 30.0
shaper_freq_y: 30.0
damping_ratio_x: 0.20
damping_ratio_y: 0.20

[virtual_sdcard]
path: /home/<your-user>/printer_data/gcodes

[pause_resume]

[exclude_object]

[display_status]

# Stock LCD status
#
# The stock LCD appears to use a parallel FSMC bus on many PDx/PEx lines.
# The stock firmware also embeds named font assets, which is additional
# evidence that the UI is a graphical TFT implementation.
# Firmware literals in the 0x60000000 / 0x64000000 / 0x68000000 ranges are
# consistent with memory-mapped 8080-style parallel TFT access via FSMC.
# Upstream Klipper does not natively support a generic FSMC TFT display, so
# there is no useful "just try ILI9341/ILI9488" config-only path here.
# Rotary encoder / button inputs are also not yet recovered well enough.
# For now, assume the stock LCD is unsupported until proven otherwise.
